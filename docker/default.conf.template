# Rendered at container start by the nginx image's envsubst step.
# ${API_UPSTREAM} and ${CDN_UPSTREAM} come from the container environment.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin proxies: the API and CDN don't send CORS headers for
    # third-party origins, so the browser talks to them through nginx.
    location ^~ /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header Origin "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location ^~ /cdn/ {
        proxy_pass ${CDN_UPSTREAM}/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        expires 7d;
    }

    # Entry points must be revalidated so new deploys are picked up.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|main\.dart\.js|version\.json|manifest\.json)$ {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(?:png|jpg|jpeg|gif|webp|svg|ico|otf|ttf|woff2?|wasm)$ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html for go_router.
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
